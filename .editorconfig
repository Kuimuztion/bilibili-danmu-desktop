root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 8
tab_width = 8
max_line_length = 80

[*.{c,h}]
indent_style = tab

[Makefile]
indent_style = tab

[*.go]
indent_style = tab

[*.{yml,yaml,json,toml,xml,html,css,md}]
indent_size = 2
